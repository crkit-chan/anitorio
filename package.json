{
  "name": "Anitorio",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite --debug",
    "build": "node scripts/run.mjs build:wasm && node scripts/run.mjs build:vite",
    "build:opt": "cross-env CARGO_UNSTABLE_BUILD_STD=panic_abort,std node scripts/run.mjs build:wasm:opt && node scripts/run.mjs build:vite",
    "build:start": "node scripts/run.mjs build:wasm && npm start",
    "build:vite": "vite build",
    "build:wasm-pack": "sh scripts/build-wasm.sh",
    "build:wasm:opt": "node scripts/run.mjs build:wasm-pack --release --features threads,kiddo",
    "build:wasm": "cross-env CARGO_TARGET_DIR=target-dev CARGO_PROFILE_DEV_OPT_LEVEL=2 CARGO_PROFILE_DEV_DEBUG=0 CARGO_ENCODED_RUSTFLAGS=-Ctarget-feature=+simd128,+bulk-memory,+mutable-globals,+nontrapping-fptoint node scripts/run.mjs build:wasm-pack --dev",
    "serve": "vite preview"
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.3",
    "@types/node": "^26.6.4",
    "@types/streamsaver": "^2.0.5",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.14",
    "vite-plugin-static-copy": "^2.2.0",
    "wasm-tracing-allocator": "^0.1.1"
  },
  "dependencies": {
    "@hevcjs/mediabunny-plugin": "^0.1.0",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "mediabunny": "^1.62.1",
    "solid-js": "^1.9.3",
    "streamsaver": "^2.0.6"
  },
  "allowScripts": {
    "esbuild": true
  },
  "prettier": {
    "arrowParens": "always",
    "printWidth": 140,
    "quoteProps": "preserve"
  }
}
