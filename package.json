    "sirv-cli": "^3.0.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.14",
    "vite-plugin-static-copy": "^2.2.0",
    "wasm-tracing-allocator": "^0.1.1"
  },
  "dependencies": {
    "@hevcjs/mediabunny-plugin": "^0.1.0",
